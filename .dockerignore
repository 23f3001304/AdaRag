# Never ship these into the image:
.venv/
.git/
.gitignore
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets and local config
.env
.env.*
.claude/

# Data volumes / caches
qdrant_storage/
pg_data/
hf_cache/
.huggingface/

# Large local media + scraped test corpus + tests — runtime/test only, never in the image
# (keeps the COPY-source layer from rebuilding when these change).
data/
evaluation/corpus/web_*.txt
tests/

# Web (not part of the API image)
web/node_modules/
web/.next/
web/out/

# Build metadata
Dockerfile
.dockerignore
